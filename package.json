{
  "name": "casepick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dev:pi": "pi --extension ./src/extension.ts",
    "dev:omp": "omp --extension ./src/extension.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ],
    "settings": {
      "debug": {
        "type": "boolean",
        "default": false,
        "description": "调试模型辅助：查看每次请求、原始回复、解析结果和核对诊断。仅在当前界面展示，不保存内容"
      },
      "draftModel": {
        "type": "string",
        "default": "",
        "description": "起草模型。留空：沿用 /casepick config（默认跟随当前模型，配置了 @casepick 角色时优先用它）；current：当前会话的模型；off：不使用模型；也可以填 @角色 或 provider/id"
      },
      "reasoning": {
        "type": "enum",
        "values": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "default": "low",
        "description": "起草模型的思考等级，默认 low；模型不支持时自动降级"
      },
      "maxOutputTokens": {
        "type": "number",
        "default": 8000,
        "min": 256,
        "max": 200000,
        "step": 1000,
        "description": "单次起草请求的输出上限"
      },
      "timeoutSeconds": {
        "type": "number",
        "default": 120,
        "min": 10,
        "max": 3600,
        "step": 10,
        "description": "单次起草请求的超时（秒）"
      }
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-ai": ">=1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@oh-my-pi/omptype": "18.10.3",
    "@types/node": "22.19.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.33"
  },
  "description": "把 Agent 的犯错整理成评测案例"
}
